+// Firefox-style keyword bookmarks. A URL bookmark's keyword is kept in its
+// meta info. Keywords are lowercase, have no whitespace, and name one URL.
+inline constexpr char kKeywordMetaInfoKey[] = "oganesson.keyword";
+
+// The keyword of `node`, or "".
+std::u16string GetBookmarkKeyword(const BookmarkNode* node);
+
+// Sets the keyword of `node` and of every bookmark of its URL (normalized as
+// above), and removes it from other URLs. An empty keyword removes theirs.
+void SetBookmarkKeyword(BookmarkModel* model,
+                        const BookmarkNode* node,
+                        const std::u16string& keyword);
+
+// For omnibox text "keyword terms", the bookmark with that keyword and its
+// URL with "%s" replaced by the escaped terms ("%S" by the terms as typed).
+// Text that is the keyword alone replaces them with nothing. Terms after the
+// keyword of a bookmark without "%s" or "%S" don't match, so they stay a
+// search. Returns {nullptr, GURL()} without a match.
+std::pair<const BookmarkNode*, GURL> ResolveBookmarkKeyword(
+    const BookmarkModel* model,
+    const std::u16string& text);
+
 }  // namespace bookmarks
 
