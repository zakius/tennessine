+void BookmarkProvider::AddKeywordBookmarkMatch(const AutocompleteInput& input) {
+  const auto [node, url] =
+      bookmarks::ResolveBookmarkKeyword(bookmark_model_, input.text());
+  if (!node) {
+    return;
+  }
+  // Above what-you-typed and search suggestions, as a keyword takes over the
+  // omnibox text in Firefox.
+  AutocompleteMatch match(this, 1500, /*deletable=*/false,
+                          AutocompleteMatchType::BOOKMARK_TITLE);
+  match.destination_url = url;
+  match.allowed_to_be_default_match = true;
+  const std::u16string formatted = url_formatter::FormatUrl(
+      url, AutocompleteMatch::GetFormatTypes(/*preserve_scheme=*/false,
+                                             /*preserve_subdomain=*/true),
+      base::UnescapeRule::SPACES, nullptr, nullptr, nullptr);
+  match.fill_into_edit = AutocompleteInput::FormattedStringWithEquivalentMeaning(
+      url, formatted, client_->GetSchemeClassifier(), nullptr);
+  match.contents = formatted;
+  match.contents_class = ClassifyTermMatches(
+      {}, match.contents.length(), ACMatchClassification::NONE,
+      ACMatchClassification::URL);
+  match.description = node->GetTitle();
+  match.description_class = ClassifyTermMatches(
+      {}, match.description.length(), ACMatchClassification::NONE,
+      ACMatchClassification::NONE);
+  matches_.push_back(std::move(match));
+}
