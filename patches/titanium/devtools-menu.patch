# From Titanium's patch.sh (jqssun/android-titanium-browser@dd8d8a9). On Chromium 156 the tablet check is only in DevToolsWindowAndroid, as patch.sh's isDevToolsAvailable line has it.
--- a/chrome/android/java/src/org/chromium/chrome/browser/contextmenu/ChromeContextMenuPopulator.java
+++ b/chrome/android/java/src/org/chromium/chrome/browser/contextmenu/ChromeContextMenuPopulator.java
@@ -490,7 +490,7 @@
                 || (mParams.getSourceType() == MenuSourceType.KEYBOARD
                         && ContentFeatureMap.isEnabled(BlinkFeatures.ANDROID_KEYBOARD_CONTEXT_MENU))
                 || (mParams.getSourceType() == MenuSourceType.LONG_PRESS
-                        && TabUtils.isUsingDesktopUserAgent(mItemDelegate.getWebContents())));
+                        && (true || TabUtils.isUsingDesktopUserAgent(mItemDelegate.getWebContents()))));
     }
 
     @VisibleForTesting
--- a/chrome/browser/devtools/android/java/src/org/chromium/chrome/browser/devtools/DevToolsWindowAndroid.java
