# Firefox Sync's strings (dubna's oganesson_firefox_sync_strings.grdp) in the browser's
# resources. Desktop adds them through its own oganesson_strings.grdp.
--- a/chrome/app/generated_resources.grd
+++ b/chrome/app/generated_resources.grd
@@ -321,6 +321,7 @@
 
       <!-- Settings specific strings -->
       <part file="settings_strings.grdp" />
+      <part file="oganesson_firefox_sync_strings.grdp" />
       <if expr="not is_android">
         <part file="shared_settings_strings.grdp"/>
       </if>
--- a/chrome/app/generated_resources.grd.gritdeps
+++ b/chrome/app/generated_resources.grd.gritdeps
@@ -14,6 +14,7 @@
 chrome/app/media_router_strings.grdp
 chrome/app/nearby_share_strings.grdp
 chrome/app/notebooks_strings.grdp
+chrome/app/oganesson_firefox_sync_strings.grdp
 chrome/app/os_settings_search_tag_strings.grdp
 chrome/app/os_settings_strings.grdp
 chrome/app/password_manager_ui_strings.grdp
