+    // tennessine: links a web app opened in tennessine while no window was ready, one per line.
+    private static final String BACKGROUND_TAB_URLS = "tennessine_background_tab_urls";
+
+    /**
+     * tennessine: opens {@code url} in a background tab of a window that is ready, or queues it
+     * for the next window to start.
+     */
+    public static void openInBackgroundTab(String url) {
+        for (Activity activity : ApplicationStatus.getRunningActivities()) {
+            if (activity instanceof ChromeTabbedActivity cta
+                    && !cta.isActivityFinishingOrDestroyed()
+                    && cta.mTabModelSelector != null
+                    && cta.mTabModelSelector.isTabStateInitialized()) {
+                cta.openBackgroundTab(url);
+                return;
+            }
+        }
+        SharedPreferences prefs = ContextUtils.getAppSharedPreferences();
+        String queued = prefs.getString(BACKGROUND_TAB_URLS, null);
+        prefs.edit()
+                .putString(BACKGROUND_TAB_URLS, queued == null ? url : queued + "\n" + url)
+                .commit();
+    }
+
+    private void openQueuedBackgroundTabs() {
+        SharedPreferences prefs = ContextUtils.getAppSharedPreferences();
+        String queued = prefs.getString(BACKGROUND_TAB_URLS, null);
+        if (queued == null) return;
+        prefs.edit().remove(BACKGROUND_TAB_URLS).commit();
+        for (String url : queued.split("\n")) openBackgroundTab(url);
+    }
+
+    private void openBackgroundTab(String url) {
+        TabModel model = assumeNonNull(mTabModelSelector).getModel(false);
+        getTabCreator(false)
+                .createNewTab(
+                        new LoadUrlParams(url),
+                        TabLaunchType.FROM_LONGPRESS_BACKGROUND,
+                        null,
+                        model.getCount());
+    }
