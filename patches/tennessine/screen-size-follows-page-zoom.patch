# screen.width, screen.availWidth and the rest are in the frame's CSS pixels, as Firefox
# reports them, not in device-independent pixels that ignore page zoom. With page zoom
# below 100% (page-zoom-follows-font-size), a page that sizes its content from
# screen.availWidth, as tibia.com's mobile tables do, otherwise stops short of the window.
--- a/third_party/blink/renderer/core/frame/screen.cc
+++ b/third_party/blink/renderer/core/frame/screen.cc
@@ -177,10 +177,12 @@
   gfx::Rect rect = available ? screen_info.available_rect : screen_info.rect;
