# Firefox Sync on Android: the settings screen joins chrome_java, its title string, and its
# entry at the top of Settings, where Fenix shows the account.
--- a/tennessine/chromium_src/chrome/android/chrome_java_ext_deps.gni
+++ b/tennessine/chromium_src/chrome/android/chrome_java_ext_deps.gni
@@ -6,6 +6,7 @@
 # Three lines of code for minimizing conflicts in rebasing changes
