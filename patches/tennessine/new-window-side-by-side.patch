+    // tennessine: whether "Open in new window" splits the screen (MultiWindowUtils).
+    private void addOpenSideBySideSwitch() {
+        ChromeSwitchPreference sideBySide = new ChromeSwitchPreference(requireContext());
+        sideBySide.setTitle("Open new windows side by side");
+        sideBySide.setSummary(
+                "Off, a new window opens full screen; switch between windows in Recents. In"
+                        + " split screen, a new window always opens beside this one.");
+        sideBySide.setChecked(
+                ContextUtils.getAppSharedPreferences()
+                        .getBoolean(MultiWindowUtils.OPEN_SIDE_BY_SIDE_PREF, true));
+        sideBySide.setOnPreferenceChangeListener(
+                (preference, newValue) -> {
+                    ContextUtils.getAppSharedPreferences()
+                            .edit()
+                            .putBoolean(MultiWindowUtils.OPEN_SIDE_BY_SIDE_PREF, (boolean) newValue)
+                            .apply();
+                    return true;
+                });
+        getPreferenceScreen().addPreference(sideBySide);
     }
 
