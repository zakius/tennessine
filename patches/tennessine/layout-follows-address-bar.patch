+    /**
+     * Moves the toolbar below the pane, its rows reversed so the buttons are nearest the edge, and
+     * keeps it above the navigation bar. In the pane's column the pane gets the remaining height in
+     * the same layout pass, so the tab list opens scrolled to the current tab.
+     */
+    private static void moveToolbarToBottom(ViewGroup hub, View attachedView) {
+        ViewGroup toolbar = hub.findViewById(R.id.hub_toolbar);
+        List<View> rows = new ArrayList<>();
+        for (int i = toolbar.getChildCount() - 1; i >= 0; i--) rows.add(toolbar.getChildAt(i));
+        toolbar.removeAllViews();
+        for (View row : rows) toolbar.addView(row);
+
+        View toolbarRoot = (View) toolbar.getParent();
+        ((ViewGroup) toolbarRoot.getParent()).removeView(toolbarRoot);
+        LinearLayout column = hub.findViewById(R.id.hub_pane_host_container);
+        MarginLayoutParams columnParams = (MarginLayoutParams) column.getLayoutParams();
+        columnParams.topMargin = 0;
+        column.setLayoutParams(columnParams);
+        column.addView(
+                toolbarRoot,
+                new LinearLayout.LayoutParams(
+                        ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT));
+
+        View searchBackground = hub.findViewById(R.id.search_box_background);
+        FrameLayout.LayoutParams backgroundParams =
+                (FrameLayout.LayoutParams) searchBackground.getLayoutParams();
+        backgroundParams.topMargin = 0;
+        searchBackground.setLayoutParams(backgroundParams);
+
+        setBottomInset(toolbarRoot, ViewCompat.getRootWindowInsets(attachedView));
+        toolbarRoot.addOnLayoutChangeListener(
+                (view, left, top, right, bottom, oldLeft, oldTop, oldRight, oldBottom) ->
+                        setBottomInset(view, ViewCompat.getRootWindowInsets(view)));
+    }
+
+    private static void setBottomInset(View view, @Nullable WindowInsetsCompat insets) {
+        if (insets == null) return;
+        int bottom = insets.getInsets(WindowInsetsCompat.Type.navigationBars()).bottom;
+        if (view.getPaddingBottom() == bottom) return;
+        view.setPadding(view.getPaddingLeft(), view.getPaddingTop(), view.getPaddingRight(), bottom);
+    }
