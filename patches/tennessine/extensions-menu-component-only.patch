# The extensions menu said "Extensions are not allowed on <site>" everywhere: uBlock Origin
# is a component extension, which ToolbarActionsModel::IsPolicyBlockedHost skips as an
# enterprise one, and with nothing left to check it answered "blocked".
--- a/chrome/browser/ui/toolbar/toolbar_actions_model.cc
+++ b/chrome/browser/ui/toolbar/toolbar_actions_model.cc
@@ -453,6 +453,9 @@ bool ToolbarActionsModel::IsPolicyBlockedHost(const GURL& url) const {
     return false;
   }
 
+  // tennessine: uBlock Origin is a component extension, so it counts as an
+  // enterprise one; with no other extension, every site came out blocked.
+  bool any_checked = false;
   for (auto& action_id : action_ids()) {
     // Skip enterprise extensions since they could still access policy-blocked
     // sites.
@@ -460,6 +463,7 @@ bool ToolbarActionsModel::IsPolicyBlockedHost(const GURL& url) const {
     if (is_enterprise_extension(*extension)) {
       continue;
     }
+    any_checked = true;
 
     // `url` is NOT a policy-blocked sit when it's allowed for any
     // non-enterprise extension.
@@ -470,7 +474,7 @@ bool ToolbarActionsModel::IsPolicyBlockedHost(const GURL& url) const {
 
   // `url` is a policy-blocked site when it's blocked for every non-enterprise
   // extension.
-  return true;
+  return any_checked;
 }
 
 bool ToolbarActionsModel::IsActionPinned(const ActionId& action_id) const {
