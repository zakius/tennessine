+    /**
+     * tennessine: orders the toolbar items from the comma-separated tokens in the app preference
+     * {@code tennessine.toolbar.items} (home, location, shortcut, extensions, tabs, menu; a leading
+     * "-" hides an item, which moves to a container that's never shown). Items before "location" go to the start container, the rest to the end
+     * one. No preference keeps Chromium's layout. Applies when the toolbar inflates.
+     */
+    private void arrangeToolbarItems() {
+        android.content.SharedPreferences prefs =
+                org.chromium.base.ContextUtils.getAppSharedPreferences();
+        String pref = prefs.getString("tennessine.toolbar.items", "");
+        // Settings > Toolbar layout offers a restart while the stored order differs from this.
+        prefs.edit().putString("tennessine.toolbar.items.applied", pref).apply();
+        if (pref.isEmpty()) return;
+        java.util.Map<String, Integer> ids = new java.util.HashMap<>();
+        ids.put("home", R.id.home_button);
+        ids.put("shortcut", R.id.optional_button_stub);
+        ids.put("extensions", R.id.extensions_toolbar_container_stub);
+        ids.put("tabs", R.id.tab_switcher_button);
+        ids.put("menu", R.id.menu_button_wrapper);
+        // Hidden items stay in the toolbar, in a container that's never shown: a ViewStub must
+        // keep a parent to inflate (the shortcut and extensions are stubs until first needed),
+        // and the coordinators keep updating their views.
+        android.widget.LinearLayout hiddenItems = new android.widget.LinearLayout(getContext());
+        hiddenItems.setVisibility(GONE);
+        addView(hiddenItems, new LayoutParams(0, 0));
+        ViewGroup target = mToolbarStartButtonsContainer;
+        for (String token : pref.split(",")) {
+            token = token.trim();
+            if (token.equals("location")) {
+                target = mToolbarButtonsContainer;
+                continue;
+            }
+            boolean hidden = token.startsWith("-");
+            Integer id = ids.get(hidden ? token.substring(1) : token);
+            // The location bar and the menu can't be hidden.
+            if (id == null || (hidden && id == R.id.menu_button_wrapper)) continue;
+            View view = findViewById(id);
+            if (view == null || !(view.getParent() instanceof ViewGroup parent)) continue;
+            parent.removeView(view);
+            if (!(view.getLayoutParams() instanceof android.widget.LinearLayout.LayoutParams)) {
+                view.setLayoutParams(
+                        new android.widget.LinearLayout.LayoutParams(
+                                view.getLayoutParams().width,
+                                ViewGroup.LayoutParams.WRAP_CONTENT));
+            }
+            (hidden ? hiddenItems : target).addView(view);
+        }
+    }
