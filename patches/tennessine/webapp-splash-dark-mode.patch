+    /**
+     * tennessine: Blink's auto dark mode for a background (dark_mode_color_classifier.cc and
+     * dark_mode_color_filter.cc). Only a color brighter than 205 of 255 changes: its CIELAB
+     * lightness L becomes min(110 - L, 100), and a gray that ends up between 18 and 32 becomes
+     * 18. White becomes #121212.
+     */
+    private static @ColorInt int darkenLikeAutoDarkMode(@ColorInt int color) {
+        int red = Color.red(color);
+        int green = Color.green(color);
+        int blue = Color.blue(color);
+        int brightness = (red * 299 + green * 587 + blue * 114) / 1000;
+        if (brightness <= 205) {
+            return color;
+        }
+        double[] lab = new double[3];
+        androidx.core.graphics.ColorUtils.colorToLAB(color, lab);
+        double lightness = Math.min(110 - lab[0], 100);
+        int dark = androidx.core.graphics.ColorUtils.LABToColor(lightness, lab[1], lab[2]);
+        int gray = Color.red(dark);
+        if (gray == Color.green(dark) && gray == Color.blue(dark) && gray > 18 && gray < 32) {
+            return Color.rgb(18, 18, 18);
+        }
+        return dark;
+    }
