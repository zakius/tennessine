# Settings → App icon: the launcher icon, chosen among activity-aliases that
# tennessine/app-icon.patch adds to AndroidManifest.xml. Joins chrome_java
# through Vanadium's chrome_java_ext_deps.gni. The drawables come from
# tools/app_icon.py.

import("//build/config/android/rules.gni")

android_resources("java_resources") {
  sources = [
    "java/res/drawable/app_icon_black.xml",
    "java/res/drawable/app_icon_crimson.xml",
    "java/res/drawable/app_icon_glyph_black.xml",
    "java/res/drawable/app_icon_glyph_white.xml",
    "java/res/drawable/app_icon_indigo.xml",
    "java/res/drawable/app_icon_teal.xml",
    "java/res/drawable/app_icon_white.xml",
  ]
}

android_library("java") {
  sources = [
    "java/src/org/chromium/chrome/browser/app_icon/AppIconSettings.java",
    "java/src/org/chromium/chrome/browser/app_icon/AppIcons.java",
  ]
  deps = [
    ":java_resources",
    "//base:supplier_java",
    "//build/android:build_java",
    "//chrome/browser/lifetime/android:java",
    "//chrome/browser/settings:java",
    "//chrome/browser/ui/android/strings:ui_strings_grd",
    "//third_party/androidx:androidx_appcompat_appcompat_java",
    "//third_party/androidx:androidx_preference_preference_java",
  ]
  resources_package = "org.chromium.chrome"
}
