# Saves the last uncaught Java exception and shows it in Settings → Last
# crash. Joins chrome_java through Vanadium's chrome_java_ext_deps.gni
# (tennessine/crash-log.patch, which also installs the handler).

import("//build/config/android/rules.gni")

android_library("java") {
  sources = [
    "java/src/org/chromium/chrome/browser/crash_log/CrashLog.java",
    "java/src/org/chromium/chrome/browser/crash_log/CrashLogSettings.java",
  ]
  deps = [
    "//base:base_java",
    "//base:supplier_java",
    "//build/android:build_java",
    "//chrome/browser/settings:java",
    "//chrome/browser/ui/android/strings:ui_strings_grd",
    "//third_party/androidx:androidx_preference_preference_java",
  ]
  resources_package = "org.chromium.chrome"
}
