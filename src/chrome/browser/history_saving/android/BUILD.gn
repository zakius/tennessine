# Privacy: the switches of oganesson's no-saved-history. Joins chrome_java
# through Vanadium's chrome_java_ext_deps.gni (tennessine/history-saving-settings.patch).

import("//build/config/android/rules.gni")

android_library("java") {
  sources = [ "java/src/org/chromium/chrome/browser/history_saving/HistorySavingSwitches.java" ]
  deps = [
    "//build/android:build_java",
    "//chrome/browser/profiles/android:java",
    "//components/browser_ui/settings/android:java",
    "//components/prefs/android:java",
    "//components/user_prefs/android:java",
    "//third_party/androidx:androidx_preference_preference_java",
  ]
}
