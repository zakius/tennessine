# Settings → Firefox Sync, tabs to and from other devices (SendTab.java), and
# the background task that fetches the tabs other devices sent
# (ReceiveTabsTask.java), which chrome_java's ChromeBackgroundTaskFactory runs
# (tennessine/firefox-sync-receive-tabs.patch).
# Joins chrome_java through Vanadium's chrome_java_ext_deps.gni
# (tennessine/firefox-sync-android.patch); the JNI side,
# firefox_sync_bridge.cc and android_platform.cc, is in ../platform.

import("//build/config/android/rules.gni")
import("//third_party/jni_zero/jni_zero.gni")

_sources = [
  "java/src/org/chromium/chrome/browser/firefox_sync/FirefoxSyncBridge.java",
  "java/src/org/chromium/chrome/browser/firefox_sync/FirefoxSyncSettings.java",
  "java/src/org/chromium/chrome/browser/firefox_sync/ReceiveTabsTask.java",
  "java/src/org/chromium/chrome/browser/firefox_sync/SendTab.java",
]

generate_jni("jni_headers") {
  sources = [
    "java/src/org/chromium/chrome/browser/firefox_sync/FirefoxSyncBridge.java",
    "java/src/org/chromium/chrome/browser/firefox_sync/ReceiveTabsTask.java",
    "java/src/org/chromium/chrome/browser/firefox_sync/SendTab.java",
  ]
}

android_library("java") {
  srcjar_deps = [ ":jni_headers" ]
  sources = _sources
  deps = [
    "//base:base_java",
    "//base:supplier_java",
    "//build/android:build_java",
    "//chrome/browser/android/browserservices/intents:java",
    "//chrome/browser/notifications:java",
    "//chrome/browser/profiles/android:java",
    "//chrome/browser/settings:java",
    "//chrome/browser/ui/android/strings:ui_strings_grd",
    "//components/background_task_scheduler:background_task_scheduler_java",
    "//components/background_task_scheduler:background_task_scheduler_task_ids_java",
    "//components/browser_ui/notifications/android:java",
    "//components/browser_ui/settings/android:java",
    "//components/browser_ui/styles/android:java_resources",
    "//third_party/androidx:androidx_appcompat_appcompat_java",
    "//third_party/androidx:androidx_preference_preference_java",
    "//third_party/jni_zero:jni_zero_java",
    "//ui/android:ui_no_recycler_view_java",
  ]
  resources_package = "org.chromium.chrome"
}
